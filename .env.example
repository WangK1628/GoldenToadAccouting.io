# 默认 AI 配置（不含 API Key，Key 由用户在设置页本地保存）
VITE_DEFAULT_AI_BASE_URL=https://api.deepseek.com
VITE_DEFAULT_AI_MODEL=deepseek-chat
VITE_DEFAULT_AI_PROVIDER=deepseek

# 邮箱验证码：本地 npm run dev / Vercel 可用。不填 RESEND 时走 FormSubmit。
VITE_EMAIL_ENABLED=true
VITE_EMAIL_API_URL=/api/send-code
RESEND_API_KEY=
MAIL_FROM=金蝉记账 <onboarding@resend.dev>

# 可选：GitHub 用户库。不填则跳过，不影响登录。
GITHUB_TOKEN=
GITHUB_REPO_OWNER=WangK1628
GITHUB_REPO_NAME=GoldenToadAccouting.io
GITHUB_USERS_BRANCH=main
GITHUB_USERS_DIR=data/users

# 可选：注册后一次 DeepSeek 试用（不要加 VITE_ 前缀）
TRIAL_DEEPSEEK_API_KEY=
TRIAL_DEEPSEEK_BASE_URL=https://api.deepseek.com
TRIAL_DEEPSEEK_MODEL=deepseek-chat
